---
import '../styles/ds.css';
import '../styles/app.css';
import { SITE, url } from '../site';

interface Props { title?: string; description?: string; current?: 'home' | 'tags' | 'about' | 'post' }
const { title, description = SITE.description, current } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const nav = [
  { key: 'home', href: url('/'), label: '日々' },
  { key: 'tags', href: url('/tags'), label: 'タグ' },
  { key: 'about', href: url('/about'), label: 'このサイト' },
] as const;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    {current === 'post' && <div class="progress" aria-hidden="true"></div>}
    <main class="wrap">
      <header class="site-head">
        <a class="mark" href={url('/')}>{SITE.name}</a>
        <span class="tag">{SITE.description}</span>
      </header>
      <slot />
      <footer class="muted small site-foot">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <a href={url('/rss.xml')}>RSS</a>
      </footer>
    </main>
    <nav class="dock" aria-label="メニュー">
      {nav.map((n) => (
        <a href={n.href} aria-current={(current === n.key || (current === 'post' && n.key === 'home')) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </body>
</html>
