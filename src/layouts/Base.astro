---
import '@fontsource-variable/inter-tight';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist-mono';
import '../styles/ds.css';
import '../styles/app.css';
import Chrome from '../components/Chrome.tsx';
import { SITE, url } from '../site';

interface Props { title?: string; description?: string; current?: 'home' | 'tags' | 'about' | 'post' }
const { title, description = SITE.description, current } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const nav = [
  { key: 'home', href: url('/'), label: '記事' },
  { key: 'tags', href: url('/tags'), label: 'タグ' },
  { key: 'about', href: url('/about'), label: 'about' },
] as const;
---
<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e4e5e6" />
    <script is:inline>try{var t=localStorage.getItem("theme");if(t==="dark"){document.documentElement.dataset.theme="dark";document.querySelector('meta[name="theme-color"]').content="#0b0b0c"}}catch(e){}</script>
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    {current === 'post' && <div class="progress" aria-hidden="true"></div>}
    <header class="bar">
      <a class="bar-mark" href={url('/')}>{SITE.name}<sup>®</sup></a>
      <nav class="bar-nav" aria-label="メニュー">
        {nav.map((n) => (
          <a href={n.href} aria-current={(current === n.key || (current === 'post' && n.key === 'home')) ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </nav>
      <span class="bar-clock" aria-hidden="true">TOKYO <b data-clock>--:--</b></span>
    </header>

    <slot />

    <footer class="foot">
      <div class="foot-row">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span class="foot-stack">Astro · React · Three.js</span>
        <button type="button" class="theme-btn" data-theme-toggle aria-label="ライト/ダークを切り替え">Light / Dark</button>
        <a href={url('/rss.xml')} data-cursor="RSS">RSS ↗</a>
      </div>
    </footer>

    <Chrome client:idle />
    <script>
      const tbtn = document.querySelector('[data-theme-toggle]');
      tbtn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0b0b0c' : '#e4e5e6');
        try { localStorage.setItem('theme', next); } catch {}
      });
      const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Tokyo', hour: '2-digit', minute: '2-digit', hour12: false });
      const el = document.querySelector('[data-clock]');
      const tick = () => { if (el) el.textContent = fmt.format(new Date()); };
      tick();
      setInterval(tick, 15000);
    </script>
  </body>
</html>
