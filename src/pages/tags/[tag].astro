---
import Base from '../../layouts/Base.astro';
import PostIndex from '../../components/PostIndex.tsx';
import { getPosts, toIndexItems, url } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} current="tags">
  <main class="section page-top">
    <a class="back" href={url('/tags')} data-cursor="戻る">← <span class="serif">All tags</span></a>
    <header class="sec-head">
      <h1 class="sec-title big"><span class="serif">#</span>{tag}</h1>
    </header>
    <PostIndex client:load items={toIndexItems(posts)} />
  </main>
</Base>
