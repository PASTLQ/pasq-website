---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.tsx';
import PostIndex from '../components/PostIndex.tsx';
import { getPosts, toIndexItems } from '../site';

const posts = await getPosts();
const items = toIndexItems(posts);
---
<Base current="home">
  <section class="hero">
    <Scene client:only="react" />
    <h1 class="sr">PASQ</h1>
    <p class="hero-cap hero-cap-b">ゆるく書き綴る、<br />実験的な日々の置き場。</p>
    <p class="hero-vert">PASQの雑記</p>
    <p class="hero-scroll" aria-hidden="true"><span>Scroll</span><i></i></p>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span>NOTES <em>—</em> 日々 <em>—</em> <span class="serif">everyday</span> <em>—</em> ゆるく <em>—</em> <span class="serif">slowly</span> <em>—</em> </span>
      ))}
    </div>
  </div>

  <main class="section" id="index">
    <header class="sec-head">
      <h2 class="sec-title"><span class="serif">Index</span> 記事</h2>
    </header>
    {posts.length === 0
      ? <p class="muted">まだ何も書かれていません。</p>
      : <PostIndex client:load items={items} />}
  </main>
</Base>
